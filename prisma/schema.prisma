// ==============================================================================
// INDOSTATES HOSPITAL DIGITAL PLATFORM — PRISMA DATABASE SCHEMA
// Database: PostgreSQL
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. HOSPITAL MODEL (Phase 5)
// ------------------------------------------------------------------------------
model Hospital {
  id             String   @id @default(cuid())
  name           String   @default("IndoStates Hospital")
  logo           String?
  tagline        String   @default("Compassionate Care. Advanced Healthcare.")
  description    String?  @db.Text
  address        String   @default("[HOSPITAL TO PROVIDE STREET ADDRESS]")
  city           String   @default("[HOSPITAL TO PROVIDE CITY]")
  state          String   @default("[HOSPITAL TO PROVIDE STATE]")
  country        String   @default("India")
  pincode        String   @default("[PINCODE]")
  phone          String   @default("+91 [HOSPITAL TO PROVIDE GENERAL PHONE]")
  emergencyPhone String   @default("+91 [HOSPITAL TO PROVIDE EMERGENCY NUMBER]")
  email          String   @default("[HOSPITAL TO PROVIDE OFFICIAL EMAIL]")
  website        String   @default("https://indostateshospital.example.com")
  workingHours   String   @default("[HOSPITAL TO CONFIRM: Mon–Sat 08:00 AM – 08:00 PM | Emergency 24/7]")
  googleMapsUrl  String   @default("https://maps.google.com/?q=IndoStates+Hospital")
  facebookUrl    String?
  instagramUrl   String?
  youtubeUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("hospitals")
}

// ------------------------------------------------------------------------------
// 2. DEPARTMENT MODEL (Phase 6)
// ------------------------------------------------------------------------------
model Department {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  shortDescription String             @db.Text
  description      String             @db.Text
  icon             String?
  image            String?
  status           String             @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relationships
  doctors          DoctorDepartment[]
  services         Service[]
  facilities       Facility[]
  appointments     Appointment[]

  @@map("departments")
}

// ------------------------------------------------------------------------------
// 3. DOCTOR & AVAILABILITY MODELS (Phase 7)
// ------------------------------------------------------------------------------
model Doctor {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  designation       String
  qualification     String
  specialization    String
  subSpecialization String?
  experience        String
  biography         String               @db.Text
  expertise         String               @db.Text // JSON string or comma-separated list
  languages         String               @db.Text // JSON string or comma-separated list
  profileImage      String?
  location          String               @default("IndoStates Hospital Main Campus")
  status            String               @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relationships
  departments       DoctorDepartment[]
  availabilities    DoctorAvailability[]
  appointments      Appointment[]

  @@map("doctors")
}

model DoctorDepartment {
  id           String     @id @default(cuid())
  doctorId     String
  departmentId String
  isPrimary    Boolean    @default(true)
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, departmentId])
  @@map("doctor_departments")
}

model DoctorAvailability {
  id          String   @id @default(cuid())
  doctorId    String
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String   // e.g. "09:00"
  endTime     String   // e.g. "13:00"
  isAvailable Boolean  @default(true)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_availabilities")
}

// ------------------------------------------------------------------------------
// 4. SERVICES & FACILITIES (Phases 8 & 9)
// ------------------------------------------------------------------------------
model Service {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  shortDescription String      @db.Text
  description      String      @db.Text
  image            String?
  departmentId     String?
  status           String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@map("services")
}

model Facility {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String      @db.Text
  image        String?
  departmentId String?
  status       String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@map("facilities")
}

// ------------------------------------------------------------------------------
// 5. HEALTH PACKAGES (Phase 10)
// ------------------------------------------------------------------------------
model HealthPackage {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  tests       String   @db.Text // JSON string of included tests
  price       String?  // Optional display price or null if unprovided
  duration    String?  // e.g. "3-4 hours"
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("health_packages")
}

// ------------------------------------------------------------------------------
// 6. HEALTH ARTICLES & EVENTS (Phases 11 & 12)
// ------------------------------------------------------------------------------
model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text // JSON or rich text markdown
  coverImage  String?
  category    String
  author      String
  status      String    @default("PUBLISHED") // DRAFT, PUBLISHED, UNPUBLISHED
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  coverImage  String?
  eventDate   DateTime
  startTime   String
  endTime     String
  location    String
  status      String   @default("UPCOMING") // UPCOMING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// ------------------------------------------------------------------------------
// 7. GALLERY & TESTIMONIALS (Phases 13 & 14)
// ------------------------------------------------------------------------------
model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  image       String
  category    String   // Hospital, Doctors, Facilities, Events, Health Camps, Other
  description String?  @db.Text
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_items")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  content     String   @db.Text
  designation String?  // e.g. "Patient Family Member"
  image       String?
  status      String   @default("ACTIVE") // ACTIVE, PENDING, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

// ------------------------------------------------------------------------------
// 8. CAREERS & APPLICATIONS (Phase 15)
// ------------------------------------------------------------------------------
model Career {
  id               String           @id @default(cuid())
  jobTitle         String
  slug             String           @unique
  department       String
  location         String           @default("IndoStates Hospital Main Campus")
  employmentType   String           @default("Full-time") // Full-time, Part-time, Rotational, Consultant
  description      String           @db.Text
  requirements     String           @db.Text // JSON array of strings
  responsibilities String           @db.Text // JSON array of strings
  status           String           @default("ACTIVE") // ACTIVE, CLOSED
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  applications     JobApplication[]

  @@map("careers")
}

model JobApplication {
  id        String   @id @default(cuid())
  careerId  String
  name      String
  email     String
  phone     String
  resumeUrl String?
  message   String?  @db.Text
  status    String   @default("PENDING") // PENDING, REVIEWED, SHORTLISTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@map("job_applications")
}

// ------------------------------------------------------------------------------
// 9. APPOINTMENTS (Phase 16)
// ------------------------------------------------------------------------------
model Appointment {
  id                String      @id @default(cuid())
  appointmentNumber String      @unique // e.g. "IND-2026-0001"
  patientName       String
  phone             String
  email             String
  patientGender     String?     @default("Not Specified")
  patientDob        String?
  patientType       String?     @default("new") // new, existing
  departmentId      String
  doctorId          String
  preferredDate     String
  preferredTime     String
  reason            String      @db.Text
  status            String      @default("PENDING") // PENDING, CONFIRMED, RESCHEDULED, CANCELLED, COMPLETED
  adminNotes        String?     @db.Text // STRICTLY PRIVATE TO ADMINS
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  department        Department  @relation(fields: [departmentId], references: [id])
  doctor            Doctor      @relation(fields: [doctorId], references: [id])

  @@map("appointments")
}

// ------------------------------------------------------------------------------
// 10. CONTACT ENQUIRIES (Phase 17)
// ------------------------------------------------------------------------------
model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW") // NEW, IN_PROGRESS, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_enquiries")
}

// ------------------------------------------------------------------------------
// 11. ADMIN USERS & RBAC (Phases 18 & 19)
// ------------------------------------------------------------------------------
model Role {
  id          String       @id @default(cuid())
  name        String       @unique // SUPER_ADMIN, HOSPITAL_ADMIN, CONTENT_MANAGER, APPOINTMENT_MANAGER
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       AdminUser[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  action    String   // create, read, update, delete, manage
  subject   String   // all, doctors, departments, appointments, articles, enquiries, settings
  createdAt DateTime @default(now())

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model AdminUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  roleId       String
  status       String     @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  role         Role       @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]

  @@map("admin_users")
}

// ------------------------------------------------------------------------------
// 12. AUDIT LOGS & NOTIFICATIONS (Phases 36 & 10)
// ------------------------------------------------------------------------------
model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String
  action      String     // e.g. "DOCTOR_CREATE", "APPOINTMENT_STATUS_UPDATE", "LOGIN"
  entity      String     // e.g. "Doctor", "Appointment", "AdminUser"
  entityId    String
  metadata    String?    @db.Text // JSON string
  timestamp   DateTime   @default(now())

  adminUser   AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  recipient String
  type      String    // EMAIL, SMS, WHATSAPP, SYSTEM
  message   String    @db.Text
  status    String    @default("PENDING") // PENDING, SENT, FAILED
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}
