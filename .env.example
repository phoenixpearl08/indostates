# IndoStates Health Hospital - Environment Template
# Duplicate this file as .env.local and populate with your production credentials

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Assistant (IndoCare AI)
GEMINI_API_KEY=

# Google OAuth Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps / Location
GOOGLE_MAPS_API_KEY=

# Application URL (for Canonical QR verification links)
NEXT_PUBLIC_APP_URL=https://indostates.com
