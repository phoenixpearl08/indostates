# ==============================================================================
# INDOSTATES HOSPITAL DIGITAL PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indostates_db?schema=public"

# Authentication Security
JWT_SECRET="indostates_secure_jwt_secret_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# CORS and Frontend URL
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Frontend API Endpoint
VITE_API_URL="http://localhost:5000/api/v1"

# Uploads Configuration
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DIR="./uploads"

# Optional Communication Desks (Phase 10 Future Readiness)
# EMAIL_API_KEY=""
# SMS_API_KEY=""
# WHATSAPP_API_KEY=""
